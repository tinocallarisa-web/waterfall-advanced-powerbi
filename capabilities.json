{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "The P&L line, driver or step. The field order, or the Order well, defines the bridge.",
      "displayNameKey": "Role_Category",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "The amount for each step. Negative values fall, positive values rise.",
      "displayNameKey": "Role_Value",
      "descriptionKey": "Role_Value_Desc"
    },
    {
      "displayName": "Target (optional)",
      "name": "target",
      "kind": "Measure",
      "description": "Goal or budget. Drawn as a dashed line on the anchor bars.",
      "displayNameKey": "Role_Target",
      "descriptionKey": "Role_Target_Desc"
    },
    {
      "displayName": "Bar type",
      "name": "barType",
      "kind": "Measure",
      "description": "Per row: total, subtotal or delta. Anything else is read as delta. Mark the first and last rows as total. Aggregate as First, not Sum.",
      "displayNameKey": "Role_BarType",
      "descriptionKey": "Role_BarType_Desc"
    },
    {
      "displayName": "Order",
      "name": "sortOrder",
      "kind": "Grouping",
      "description": "Numeric field that fixes the sequence of the bridge. Without it the bars follow the category sort.",
      "displayNameKey": "Role_Order",
      "descriptionKey": "Role_Order_Desc"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra measures shown on hover.",
      "displayNameKey": "Role_Tooltips",
      "descriptionKey": "Role_Tooltips_Desc"
    },
    {
      "displayName": "Colour (DAX, optional)",
      "name": "colorBy",
      "kind": "Measure",
      "description": "A hex colour per row, calculated in the model. Overrides the increase/decrease colours and the fx rule.",
      "displayNameKey": "Role_Color",
      "descriptionKey": "Role_Color_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "sortOrder"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {}
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "target"
              }
            },
            {
              "bind": {
                "to": "barType"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            },
            {
              "bind": {
                "to": "colorBy"
              }
            }
          ]
        }
      }
    }
  ],
