{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "./dist",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "moduleResolution": "node",
    "useUnknownInCatchVariables": false
  },
  "files": [
    "./src/visual.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
